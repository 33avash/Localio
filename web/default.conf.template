server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types application/geo+json application/json application/javascript text/css;

    location / {
        try_files $uri $uri/ =404;
    }

    # Pipeline output, bind-mounted from ./output. Never cached: after a
    # re-run the browser has to show the new numbers, not the last ones.
    location /data/ {
        alias /srv/localio-data/;
        add_header Cache-Control "no-store";
        types {
            application/geo+json geojson;
            application/json json;
        }
    }

    # The chat API. The name is resolved per request through Docker's DNS,
    # so the map still loads (and the chat says so) if api isn't running.
    location /api/ {
        resolver 127.0.0.11 valid=10s ipv6=off;
        resolver_timeout 2s;
        set $api_upstream http://api:8000;
        proxy_pass $api_upstream;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 20s;
    }

    # Filled in from the environment when the container starts. An empty
    # key makes the page fall back to OpenStreetMap tiles.
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"cartoKey": "${LOCALIO_CARTO_KEY}"}';
    }
}
