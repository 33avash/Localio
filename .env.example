# Free key from https://carto.com/basemaps (CARTO Positron tiles).
# Leave it empty to use OpenStreetMap tiles instead.
LOCALIO_CARTO_KEY=

# Free key from https://aistudio.google.com/apikey: Gemini writes the chat's
# answers from Localio's data. Leave it empty for the built-in answers.
GEMINI_API_KEY=
