# Free key from https://carto.com/basemaps (CARTO Positron tiles).
# Leave it empty to use OpenStreetMap tiles instead.
LOCALIO_CARTO_KEY=

# Free key from https://aistudio.google.com/apikey (Gemini Flash writes the
# chat's answers). Leave it empty and the chat answers from templates.
# Google may use free-tier prompts to improve its products; Localio only
# sends the question and public ward figures.
GEMINI_API_KEY=
